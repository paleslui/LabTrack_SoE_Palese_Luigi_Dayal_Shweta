# LabTrack Environment Configuration
# Copy this file to .env and fill in the values.
# .env is excluded from git — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-random-secret-key

# ── Optional: Email notifications ─────────────────────────────────────────────
# Set MAIL_ENABLED=True and fill in SMTP credentials to enable expiry alerts.
# For Gmail: create an App Password at Google Account → Security → App Passwords
MAIL_ENABLED=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=LabTrack <noreply@labtrack.local>
MAIL_EXPIRY_DAYS_WARNING=7

# ── Optional: Database ────────────────────────────────────────────────────────
# Default is SQLite (labtrack.db in project root).
# Change to PostgreSQL URI for production:
# DATABASE_URI=postgresql://user:password@localhost/labtrack
DATABASE_URI=sqlite:///labtrack.db
